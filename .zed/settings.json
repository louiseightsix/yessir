{
  "languages": {
    "Python": {
      "language_servers": ["pyrefly", "..."],
      "formatter": {
        "external": {
          "command": "uv",
          "arguments": ["run", "ruff", "format", "-"]
        }
      }
    }
  },
  "lsp": {
