---
// `/` redirects to the first experiment's Studies page. A meta refresh, because
// the site is static HTML (Astro.redirect's static version waits 2 seconds).
import { getSiteData } from "../lib/data";

const first = getSiteData().experiments[0];
const target = first ? `/${first.name}/` : null;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>yessir</title>
    {target && <meta http-equiv="refresh" content={`0;url=${target}`} />}
    {target && <link rel="canonical" href={target} />}
  </head>
  <body>
    {
      target ? (
        <p>
          Redirecting to <a href={target}>{target}</a>…
        </p>
      ) : (
        <p>No experiments found under <code>results/</code>, <code>studies/</code> or the schema export.</p>
      )
    }
  </body>
</html>
