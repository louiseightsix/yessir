---
// Runs at build time only (and on each request under `astro dev`).
import { execFileSync } from "node:child_process";
import { existsSync, readdirSync, readFileSync } from "node:fs";
import { resolve } from "node:path";
import ConfigBuilder, {
  type ExistingRunConfig,
  type ExperimentSchema,
} from "../components/ConfigBuilder";

// Astro runs with web/ as the working directory; the repo root is one up.
const repoRoot = resolve(process.cwd(), "..");

// Plain python3, not `uv run`: the export needs only the standard library,
// so the build doesn't have to install torch. YESSIR_PYTHON overrides it.
const python = process.env.YESSIR_PYTHON ?? "python3";
const pythonVersion = execFileSync(python, ["--version"], { encoding: "utf8" }).trim();

const schemas: Record<string, ExperimentSchema> = JSON.parse(
  execFileSync(python, ["-m", "experiments.web_export"], { cwd: repoRoot, encoding: "utf8" }),
);

interface ConfigFile {
  experiment?: string;
  variant?: string;
  device?: string;
  git_commit_sha?: string;
  git_short_sha?: string;
  git_commit_date?: string;
  git_dirty?: boolean;
  config?: Record<string, unknown>;
}

interface TrainPoint {
  step: number;
  elapsed_sec: number;
  loss: number;
}

interface RunData {
  name: string;
  meta: ConfigFile | null;
  evalMetrics: Record<string, number> | null;
  trainPoints: TrainPoint[];
  readmeBody: string | null;
  flawedReason: string | null;
}

// Keep in sync with `Study` / `StudyRun` in `yessir/artefacts.py`.
interface StudyRunEntry {
  run_name: string;
  label?: string | null;
}

interface StudyFile {
  title?: string;
  status?: string;
  kind?: string | null;
  question?: string | null;
  runs?: StudyRunEntry[];
  conclusion?: string | null;
}

interface StudyData {
  slug: string;
  title: string;
  status: string;
  kind: string | null;
  question: string | null;
  runs: Array<{ run_name: string; label: string | null }>;
  conclusion: string | null;
}

function readJsonIfExists<T>(path: string): T | null {
  if (!existsSync(path)) return null;
  try {
    return JSON.parse(readFileSync(path, "utf8")) as T;
  } catch {
    return null;
  }
}

function readTrainJsonl(path: string): TrainPoint[] {
  if (!existsSync(path)) return [];
  const points: TrainPoint[] = [];
  for (const line of readFileSync(path, "utf8").split("\n")) {
    const trimmed = line.trim();
    if (!trimmed) continue;
    try {
      points.push(JSON.parse(trimmed) as TrainPoint);
    } catch {
      // Ignore a trailing half-written line while a run is in progress.
    }
  }
  return points;
}

function loadRun(runDir: string, name: string): RunData {
  const meta = readJsonIfExists<ConfigFile>(resolve(runDir, "config.json"));
  const evalMetrics = readJsonIfExists<Record<string, number>>(resolve(runDir, "eval.json"));
  const trainPoints = readTrainJsonl(resolve(runDir, "train.jsonl"));
  const readmePath = resolve(runDir, "README.md");
  const rawReadme = existsSync(readmePath) ? readFileSync(readmePath, "utf8").trim() : null;
  const lines = rawReadme ? rawReadme.split("\n") : [];
  const firstLine = lines[0] ?? "";
  const isFlawed = firstLine.startsWith("FLAWED:");
  const flawedReason = isFlawed ? firstLine.slice("FLAWED:".length).trim() : null;
  const remaining = (isFlawed ? lines.slice(1) : lines).join("\n").trim();
  const readmeBody = remaining.length > 0 ? remaining : null;
  return { name, meta, evalMetrics, trainPoints, readmeBody, flawedReason };
}

function lossSvgPoints(points: TrainPoint[], width: number, height: number): string {
  if (points.length === 0) return "";
  const pad = 4;
  const innerW = width - 2 * pad;
  const innerH = height - 2 * pad;
  if (points.length === 1) {
    const midY = (height / 2).toFixed(1);
    return `${pad.toFixed(1)},${midY} ${(width - pad).toFixed(1)},${midY}`;
  }
  const minStep = points[0].step;
  const maxStep = points[points.length - 1].step;
  let minLoss = Infinity;
  let maxLoss = -Infinity;
  for (const p of points) {
    if (p.loss < minLoss) minLoss = p.loss;
    if (p.loss > maxLoss) maxLoss = p.loss;
  }
  const stepSpan = Math.max(1, maxStep - minStep);
  const lossSpan = maxLoss > minLoss ? maxLoss - minLoss : 1;
  return points
    .map((p) => {
      const x = pad + ((p.step - minStep) / stepSpan) * innerW;
      const y = height - pad - ((p.loss - minLoss) / lossSpan) * innerH;
      return `${x.toFixed(1)},${y.toFixed(1)}`;
    })
    .join(" ");
}

function loadStudies(expStudiesDir: string): StudyData[] {
  if (!existsSync(expStudiesDir)) return [];
  return readdirSync(expStudiesDir, { withFileTypes: true })
    .filter((entry) => entry.isFile() && entry.name.endsWith(".json"))
    .sort((a, b) => a.name.localeCompare(b.name))
    .flatMap((entry) => {
      const raw = readJsonIfExists<StudyFile>(resolve(expStudiesDir, entry.name));
      if (!raw || typeof raw.title !== "string") return [];
      const slug = entry.name.slice(0, -".json".length);
      const runs = Array.isArray(raw.runs)
        ? raw.runs
            .filter((r): r is StudyRunEntry => Boolean(r && typeof r.run_name === "string"))
            .map((r) => ({
              run_name: r.run_name,
              label: typeof r.label === "string" ? r.label : null,
            }))
        : [];
      return [
        {
          slug,
          title: raw.title,
          status: typeof raw.status === "string" ? raw.status : "draft",
          kind: typeof raw.kind === "string" ? raw.kind : null,
          question: typeof raw.question === "string" ? raw.question : null,
          runs,
          conclusion: typeof raw.conclusion === "string" ? raw.conclusion : null,
        },
      ];
    });
}

function listSubdirs(dir: string): string[] {
  if (!existsSync(dir)) return [];
  return readdirSync(dir, { withFileTypes: true })
    .filter((entry) => entry.isDirectory())
    .map((entry) => entry.name);
}

const resultsDir = resolve(repoRoot, "results");
const studiesDir = resolve(repoRoot, "studies");
const experimentNames = Array.from(
  new Set([...listSubdirs(resultsDir), ...listSubdirs(studiesDir)]),
).sort((a, b) => a.localeCompare(b));

const experiments = experimentNames.map((name) => {
  const expResultsDir = resolve(resultsDir, name);
  const runs = listSubdirs(expResultsDir)
    .map((runName) => loadRun(resolve(expResultsDir, runName), runName))
    .sort((a, b) => b.name.localeCompare(a.name));
  const studies = loadStudies(resolve(studiesDir, name));
  const runsByName = new Map(runs.map((r) => [r.name, r]));
  const studiesByRun = new Map<
    string,
    Array<{ slug: string; title: string; label: string | null }>
  >();
  for (const study of studies) {
    for (const entry of study.runs) {
      const list = studiesByRun.get(entry.run_name) ?? [];
      list.push({ slug: study.slug, title: study.title, label: entry.label });
      studiesByRun.set(entry.run_name, list);
    }
  }
  return { name, runs, studies, runsByName, studiesByRun };
});

const experimentsWithStudies = experiments.filter((exp) => exp.studies.length > 0);
const experimentsWithRuns = experiments.filter((exp) => exp.runs.length > 0);

const existingRuns: Record<string, ExistingRunConfig[]> = Object.fromEntries(
  experiments.map((exp) => [
    exp.name,
    exp.runs
      .filter((run): run is RunData & { meta: { config: Record<string, unknown> } } =>
        Boolean(run.meta?.config),
      )
      .map((run) => ({
        name: run.name,
        variant: run.meta.variant,
        config: run.meta.config,
      })),
  ]),
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>yessir</title>
    <style>
      body {
        font-family: system-ui, sans-serif;
        max-width: 64rem;
        margin: 2rem auto;
        padding: 0 1rem;
        line-height: 1.45;
      }
      .run-card {
        border: 1px solid #ccc;
        border-radius: 6px;
        padding: 1rem;
        margin-bottom: 1.25rem;
      }
      .run-card.flawed {
        border-color: #c00;
        background: #fff8f8;
      }
      .flawed-banner {
        color: #900;
        font-weight: 600;
        margin: 0.5rem 0;
      }
      .meta {
        color: #555;
        font-size: 0.9rem;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
        gap: 1rem;
        margin-top: 0.75rem;
      }
      table {
        border-collapse: collapse;
        width: 100%;
        font-size: 0.9rem;
      }
      th, td {
        text-align: left;
        padding: 0.2rem 0.4rem;
        border-bottom: 1px solid #eee;
      }
      tr.non-default td {
        font-weight: 600;
      }
      svg.loss-curve {
        display: block;
        border: 1px solid #ddd;
        background: #fafafa;
        margin-top: 0.4rem;
      }
      .config-builder {
        border: 1px solid #ccc;
        border-radius: 6px;
        padding: 1rem;
        margin-bottom: 2rem;
      }
      .builder-toolbar, .cli-header {
        display: flex;
        align-items: center;
        gap: 1rem;
      }
      .numeric-control {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
      }
      .duplicate-warning {
        color: #92400e;
        background: #fef3c7;
        border: 1px solid #f59e0b;
        border-radius: 4px;
        padding: 0.5rem 0.75rem;
        margin: 0.75rem 0;
      }
      .status-valid {
        color: #166534;
        background: #f0fdf4;
        border: 1px solid #86efac;
        border-radius: 4px;
        padding: 0.5rem 0.75rem;
        margin: 0.75rem 0;
      }
      .status-invalid {
        color: #991b1b;
        background: #fef2f2;
        border: 1px solid #fca5a5;
        border-radius: 4px;
        padding: 0.5rem 0.75rem;
        margin: 0.75rem 0;
      }
      .cli-output {
        margin-top: 1rem;
      }
      .cli-output pre {
        background: #f5f5f5;
        border: 1px solid #ddd;
        border-radius: 4px;
        padding: 0.6rem 0.8rem;
        overflow-x: auto;
      }
      .study-card {
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        padding: 1rem;
        margin-bottom: 1.25rem;
        background: #f8fafc;
      }
      .study-header {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 0.4rem;
      }
      .study-header h4 {
        margin: 0;
      }
      .badge {
        display: inline-block;
        font-size: 0.78rem;
        font-weight: 600;
        padding: 0.1rem 0.45rem;
        border-radius: 4px;
        border: 1px solid #cbd5e1;
        background: #fff;
        color: #334155;
      }
      .badge.status-draft {
        background: #fef9c3;
        border-color: #fde047;
        color: #854d0e;
      }
      .badge.status-in_progress {
        background: #dbeafe;
        border-color: #93c5fd;
        color: #1e40af;
      }
      .badge.status-concluded {
        background: #dcfce7;
        border-color: #86efac;
        color: #166534;
      }
      .study-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin: 0.4rem 0;
        font-size: 0.85rem;
      }
    </style>
  </head>
  <body>
    <h1>yessir</h1>
    <p>Results browser and config builder for the yessir experiments (built with {pythonVersion}).</p>

    <h2>Config builder</h2>
    <ConfigBuilder client:load schemas={schemas} existingRuns={existingRuns} />

    <h2>Studies</h2>
    {experimentsWithStudies.length === 0 && (
      <p>No studies recorded under <code>studies/</code> yet.</p>
    )}
    {experimentsWithStudies.map((exp) => {
      const expVariants = schemas[exp.name]?.variants ?? [];
      return (
        <section>
          <h3>
            {exp.name} ({exp.studies.length} {exp.studies.length === 1 ? "study" : "studies"})
          </h3>
          {exp.studies.map((study) => (
            <article class="study-card" id={`study-${exp.name}-${study.slug}`}>
              <div class="study-header">
                <h4>{study.title}</h4>
                <code class="meta">{study.slug}</code>
                <span class={`badge status-${study.status}`}>{study.status}</span>
                {study.kind && <span class="badge">{study.kind}</span>}
              </div>
              {study.question && <p><strong>Question:</strong> {study.question}</p>}
              {study.runs.length > 0 ? (
                <table>
                  <thead>
                    <tr>
                      <th>Run</th>
                      <th>Label</th>
                      <th>Non-default config</th>
                      <th>Evaluation</th>
                    </tr>
                  </thead>
                  <tbody>
                    {study.runs.map((entry) => {
                      const matched = exp.runsByName.get(entry.run_name);
                      const runVariant = matched?.meta?.variant;
                      const defaultConfig =
                        expVariants.find((v) => v.name === runVariant)?.default_config ??
                        expVariants[0]?.default_config ??
                        {};
                      const runConfig = matched?.meta?.config ?? {};
                      const nonDefaults = Object.entries(runConfig).filter(
                        ([k, v]) => k in defaultConfig && defaultConfig[k] !== v,
                      );
                      return (
                        <tr>
                          <td>
                            {matched ? (
                              <a href={`#run-${exp.name}-${entry.run_name}`}>
                                <code>{entry.run_name}</code>
                              </a>
                            ) : (
                              <code>{entry.run_name}</code>
                            )}
                            {matched?.flawedReason !== null && matched?.flawedReason !== undefined && (
                              <span class="flawed-banner"> [FLAWED]</span>
                            )}
                          </td>
                          <td>{entry.label ?? "—"}</td>
                          <td>
                            {nonDefaults.length > 0
                              ? nonDefaults.map(([k, v], idx) => (
                                  <>
                                    {idx > 0 && ", "}
                                    <code>
                                      {k}={JSON.stringify(v)}
                                    </code>
                                  </>
                                ))
                              : matched
                                ? "defaults"
                                : "—"}
                          </td>
                          <td>
                            {matched?.evalMetrics
                              ? Object.entries(matched.evalMetrics).map(([k, v], idx) => (
                                  <>
                                    {idx > 0 && ", "}
                                    <code>
                                      {k}={typeof v === "number" ? v.toFixed(4) : String(v)}
                                    </code>
                                  </>
                                ))
                              : matched
                                ? "not evaluated"
                                : "run not found"}
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              ) : (
                <p class="meta">No runs attached yet.</p>
              )}
              {study.conclusion && <p><strong>Conclusion:</strong> {study.conclusion}</p>}
            </article>
          ))}
        </section>
      );
    })}

    <h2>Results</h2>
    {experimentsWithRuns.length === 0 && <p>No results yet.</p>}
    {experimentsWithRuns.map((exp) => {
      const expVariants = schemas[exp.name]?.variants ?? [];
      return (
        <section>
          <h3>{exp.name} ({exp.runs.length} {exp.runs.length === 1 ? "run" : "runs"})</h3>
          {exp.runs.length === 0 && <p>No runs recorded.</p>}
          {exp.runs.map((run) => {
            const first = run.trainPoints[0];
            const last = run.trainPoints[run.trainPoints.length - 1];
            const minLoss = run.trainPoints.reduce(
              (acc, p) => (p.loss < acc ? p.loss : acc),
              Infinity,
            );
            const runVariant = run.meta?.variant;
            const defaultConfig =
              expVariants.find((v) => v.name === runVariant)?.default_config ??
              expVariants[0]?.default_config ??
              {};
            const runConfig = run.meta?.config ?? {};
            const totalSteps = typeof runConfig.steps === "number" ? runConfig.steps : null;
            const memberStudies = exp.studiesByRun.get(run.name) ?? [];
            return (
              <article
                class={`run-card${run.flawedReason !== null ? " flawed" : ""}`}
                id={`run-${exp.name}-${run.name}`}
              >
                <h4>{run.name}</h4>
                <div class="meta">
                  {runVariant && (
                    <>
                      <span>
                        variant <code>{runVariant}</code>
                      </span>
                      {" · "}
                    </>
                  )}
                  {run.meta?.device && (
                    <>
                      <span>
                        device <code>{run.meta.device}</code>
                      </span>
                      {" · "}
                    </>
                  )}
                  {run.meta?.git_short_sha && (
                    <span>
                      commit <code>{run.meta.git_short_sha}</code> ({run.meta.git_commit_date})
                      {run.meta.git_dirty ? " [dirty]" : ""}
                    </span>
                  )}
                  {" · "}
                  <span>{run.evalMetrics ? "evaluated" : "in progress / no eval.json"}</span>
                </div>
                {memberStudies.length > 0 && (
                  <div class="study-tags">
                    <span class="meta">Studies:</span>
                    {memberStudies.map((s) => (
                      <a class="badge" href={`#study-${exp.name}-${s.slug}`}>
                        {s.title}
                        {s.label ? ` (${s.label})` : ""}
                      </a>
                    ))}
                  </div>
                )}

                {run.flawedReason !== null && (
                  <p class="flawed-banner">FLAWED: {run.flawedReason}</p>
                )}
                {run.readmeBody && <pre>{run.readmeBody}</pre>}

                <div class="grid">
                  <div>
                    <h5>Evaluation (<code>eval.json</code>)</h5>
                    {run.evalMetrics ? (
                      <table>
                        <tbody>
                          {Object.entries(run.evalMetrics).map(([k, v]) => (
                            <tr>
                              <th>{k}</th>
                              <td>{typeof v === "number" ? v.toFixed(4) : String(v)}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    ) : (
                      <p>Not evaluated yet.</p>
                    )}

                    <h5>Training (<code>train.jsonl</code>)</h5>
                    {last ? (
                      <>
                        <table>
                          <tbody>
                            <tr>
                              <th>Step</th>
                              <td>
                                {last.step}
                                {totalSteps !== null ? ` / ${totalSteps}` : ""}
                              </td>
                            </tr>
                            <tr>
                              <th>Loss (first → last)</th>
                              <td>
                                {first.loss.toFixed(4)} → {last.loss.toFixed(4)} (min{" "}
                                {minLoss.toFixed(4)})
                              </td>
                            </tr>
                            <tr>
                              <th>Elapsed</th>
                              <td>{last.elapsed_sec.toFixed(1)}s</td>
                            </tr>
                          </tbody>
                        </table>
                        <svg
                          class="loss-curve"
                          width="280"
                          height="80"
                          viewBox="0 0 280 80"
                          aria-label="Training loss curve"
                        >
                          <polyline
                            fill="none"
                            stroke="#2563eb"
                            stroke-width="1.5"
                            points={lossSvgPoints(run.trainPoints, 280, 80)}
                          />
                        </svg>
                      </>
                    ) : (
                      <p>No training steps recorded.</p>
                    )}
                  </div>

                  <div>
                    <h5>Config (<code>config.json</code>)</h5>
                    {Object.keys(runConfig).length > 0 ? (
                      <table>
                        <tbody>
                          {Object.entries(runConfig).map(([k, v]) => {
                            const isNonDefault =
                              k in defaultConfig && defaultConfig[k] !== v;
                            return (
                              <tr class={isNonDefault ? "non-default" : undefined}>
                                <th>{k}</th>
                                <td>
                                  <code>{JSON.stringify(v)}</code>
                                  {isNonDefault && (
                                    <span class="meta">
                                      {" "}
                                      (default: <code>{JSON.stringify(defaultConfig[k])}</code>)
                                    </span>
                                  )}
                                </td>
                              </tr>
                            );
                          })}
                        </tbody>
                      </table>
                    ) : (
                      <p>No config recorded.</p>
                    )}
                  </div>
                </div>
              </article>
            );
          })}
        </section>
      );
    })}
  </body>
</html>
