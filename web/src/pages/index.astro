---
// Landing page: every experiment, each linking to its Studies page. No sidebar,
// because the sidebar (picker, nav, "Running now") belongs to one experiment.
import "../styles/global.css";
import { getSiteData } from "../lib/data";
// Astro turns an imported SVG into a component that inlines it into the HTML.
import Wordmark from "../../../wordmark/yessir-wordmark-light.svg";

const site = getSiteData();

/** "1 study", "3 studies". */
function count(n: number, one: string, many: string): string {
  return `${n} ${n === 1 ? one : many}`;
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>yessir — Experiments</title>
  </head>
  <body>
    <main class="landing">
      <div class="wordmark">
        <span class="wordmark-name"><Wordmark /></span>
      </div>

      <header class="page-header">
        <div>
          <h1>Experiments</h1>
          <p>Each experiment has its own studies and runs.</p>
        </div>
      </header>

      {
        site.experiments.length === 0 ? (
          <p class="muted">
            No experiments found under <code>results/</code>, <code>studies/</code> or the schema export.
          </p>
        ) : (
          <ul class="experiment-list">
            {site.experiments.map((exp) => {
              const running = exp.runs.filter((r) => r.status === "in_progress").length;
              return (
                <li>
                  <a class="panel experiment-card" href={`/${exp.name}/`}>
                    <span class="experiment-name mono">{exp.name}</span>
                    {exp.schema?.description && <span class="muted">{exp.schema.description}</span>}
                    <span class="experiment-counts muted">
                      {count(exp.studies.length, "study", "studies")} · {count(exp.runs.length, "run", "runs")}
                      {running > 0 && ` · ${running} running`}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        )
      }

      <p class="muted credit">
        Logo emoji by <a href="https://openmoji.org/">OpenMoji</a>, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>
      </p>
    </main>
  </body>
</html>

<style>
  /* One centred column: on a wide screen the content sits in the middle
     rather than hugging the left edge. More room above and between sections
     than the sidebar pages, since this page has little on it. */
  .landing {
    max-width: 640px;
    margin: 0 auto;
    box-sizing: border-box;
    padding: 80px 40px 64px;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  /* The logo and heading are centred over the column; the cards below keep
     left-aligned text, which is easier to scan. */
  .wordmark {
    justify-content: center;
  }
  .page-header {
    justify-content: center;
    text-align: center;
  }
  .page-header > div {
    gap: 8px;
  }

  .experiment-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* The whole card is the link, so it reads as one block rather than underlined text. */
  .experiment-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px 24px;
    color: var(--c-ink);
  }
  .experiment-card:hover {
    color: var(--c-ink);
    text-decoration: none;
    border-color: var(--c-border-strong);
  }

  .experiment-name {
    font-size: 16px;
    font-weight: 600;
    color: var(--c-accent-strong);
  }

  .credit {
    margin: 0;
    text-align: center;
    font-size: var(--fs-tiny);
  }

  .experiment-counts {
    font: 400 var(--fs-small) var(--font-mono);
  }
</style>
