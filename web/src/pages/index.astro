---
// Landing page: a short intro to yessir and its link to Into the Matrix, then
// every experiment, each linking to its Studies page. No sidebar,
// because the sidebar (picker, nav, "Running now") belongs to one experiment.
import "../styles/global.css";
import { getSiteData } from "../lib/data";
// Astro turns an imported SVG into a component that inlines it into the HTML.
import Wordmark from "../../../wordmark/yessir-wordmark-light.svg";

const site = getSiteData();

/** "1 study", "3 studies". */
function count(n: number, one: string, many: string): string {
  return `${n} ${n === 1 ? one : many}`;
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>yessir — Experiments</title>
  </head>
  <body>
    <main class="landing">
      <!-- What yessir is and where it belongs, for a visitor arriving cold. The
           wordmark is the page's h1: its SVG carries the accessible name "Yessir!". -->
      <header class="intro">
        <h1 class="wordmark">
          <span class="wordmark-name"><Wordmark /></span>
        </h1>
        <p class="lede">
          <strong>Yessir!</strong> is a playground for exploring rule-following behaviour in transformer-based models.
        </p>
        <p class="intro-links">
          <a href="https://anamorphosis.cc/into-the-matrix/">Into the Matrix</a>
          <span aria-hidden="true">·</span>
          <a href="https://github.com/louiseightsix/yessir">GitHub</a>
        </p>
      </header>

      <!-- Two columns on desktop (about on the left, experiments on the right),
           stacked in that order on narrow screens. -->
      <div class="columns">
        <section class="about">
          <p class="muted">
            It's the experimental side of <a href="https://anamorphosis.cc/into-the-matrix/">Into the Matrix</a>, an
            unscripted adventure to the frontiers of AI. The series makes deliberately bold claims about what models
            can and can't do with rules; yessir is where I build small, controlled experiments to put them to the test.
          </p>
        </section>

        <section class="experiments">
          <h2 class="eyebrow">Experiments</h2>

          {
            site.experiments.length === 0 ? (
              <p class="muted">
                No experiments found under <code>results/</code>, <code>studies/</code> or the schema export.
              </p>
            ) : (
              <ul class="experiment-list">
                {site.experiments.map((exp) => {
                  const running = exp.runs.filter((r) => r.status === "in_progress").length;
                  return (
                    <li>
                      <a class="panel experiment-card" href={`/${exp.name}/`}>
                        <span class="experiment-name mono">{exp.name}</span>
                        {exp.schema?.description && <span class="muted">{exp.schema.description}</span>}
                        <span class="experiment-counts muted">
                          {count(exp.studies.length, "study", "studies")} · {count(exp.runs.length, "run", "runs")}
                          {running > 0 && ` · ${running} running`}
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            )
          }
        </section>
      </div>

      <p class="muted credit">
        Logo emoji by <a href="https://openmoji.org/">OpenMoji</a>, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>
      </p>
    </main>
  </body>
</html>

<style>
  /* Centred on the screen rather than hugging the left edge. Wide enough for
     two columns on desktop; on a narrow screen everything stacks. More room
     above and between sections than the sidebar pages, since this page has
     little on it. */
  .landing {
    max-width: 960px;
    margin: 0 auto;
    box-sizing: border-box;
    padding: 80px 40px 64px;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  /* Logo, one-line description and links, centred over both columns. Plain
     text, not a panel: the only boxes on the page are the experiment cards, so
     they read as the things to click. */
  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
  }
  .wordmark {
    justify-content: center;
    margin-bottom: 10px;
  }
  /* The one-line answer to "what is this?", a step up from body text. */
  .lede {
    margin: 0;
    max-width: 560px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--c-ink);
  }
  .intro-links {
    margin: 0;
    display: flex;
    gap: 10px;
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--c-muted);
  }

  /* Narrow screens: one column, about first, then experiments. */
  .columns {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .about p {
    margin: 0;
    line-height: 1.6;
  }

  /* A small label rather than a second big heading: the logo is the page title. */
  .experiments {
    display: grid;
    gap: 12px;
  }

  /* Desktop: about on the left, experiments (the wider column) on the right.
     The grid has two rows, the "Experiments" label and then the cards. The
     experiments section shares those rows with the parent (subgrid), and the
     about text sits in the second row, so its first line lines up with the top
     of the first card rather than with the label. */
  @media (min-width: 860px) {
    .columns {
      display: grid;
      grid-template-columns: 5fr 7fr;
      grid-template-rows: auto 1fr;
      column-gap: 56px;
      row-gap: 12px;
    }
    .about {
      grid-column: 1;
      grid-row: 2;
    }
    .experiments {
      grid-column: 2;
      grid-row: 1 / span 2;
      grid-template-rows: subgrid;
    }
  }

  .experiment-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* The whole card is the link, so it reads as one block rather than underlined text. */
  .experiment-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px 24px;
    color: var(--c-ink);
  }
  .experiment-card:hover {
    color: var(--c-ink);
    text-decoration: none;
    border-color: var(--c-border-strong);
  }

  .experiment-name {
    font-size: 16px;
    font-weight: 600;
    color: var(--c-accent-strong);
  }

  .credit {
    margin: 0;
    text-align: center;
    font-size: var(--fs-tiny);
  }

  .experiment-counts {
    font: 400 var(--fs-small) var(--font-mono);
  }
</style>
