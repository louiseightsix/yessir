---
// Runs table for an experiment.
import Shell from "../../../layouts/Shell.astro";
import { getExperiment, getSiteData } from "../../../lib/data";

export function getStaticPaths() {
  return getSiteData().experiments.map((e) => ({ params: { experiment: e.name } }));
}

const { experiment } = Astro.params;
const exp = getExperiment(experiment);
---

<Shell title="Runs" experiment={experiment} section="runs">
  <header class="page-header">
    <div>
      <h1>Runs</h1>
      <p>
        Every training run of <code>{exp.name}</code>, newest first. Settings are shown only where
        they differ from the variant default.
      </p>
    </div>
  </header>
</Shell>
