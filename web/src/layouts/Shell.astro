---
// App shell: sidebar (experiment picker, nav, footer) and content area.
import "../styles/global.css";
import { getExperiment, getSiteData } from "../lib/data";
// Astro turns an imported SVG into a component that inlines it into the HTML.
import Wordmark from "../../../wordmark/yessir-wordmark-light.svg";

export type Section = "studies" | "runs" | "new";

interface Props {
  /** Page title, shown in the browser tab after "yessir — ". */
  title: string;
  experiment: string;
  /** Which nav link is active. Detail pages pass their parent section. */
  section: Section;
}

const { title, experiment, section } = Astro.props;
const site = getSiteData();
const exp = getExperiment(experiment);

// Where each nav link goes, relative to the experiment prefix. The experiment
// picker reuses this so switching experiment keeps you in the same section.
const sectionPaths: Record<Section, string> = { studies: "", runs: "runs/", new: "new/" };
const navLinks: Array<{ section: Section; label: string; count: number | null; icon: string }> = [
  { section: "studies", label: "Studies", count: exp.studies.length, icon: "M2.5 3h4.5v10H2.5zM9 3h4.5v10H9z" },
  { section: "runs", label: "Runs", count: exp.runs.length, icon: "M2.5 4h11M2.5 8h11M2.5 12h11" },
  { section: "new", label: "New run", count: null, icon: "M8 3v10M3 8h10" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>yessir — {title}</title>
  </head>
  <body>
    <div class="shell">
      <nav aria-label="Primary" class="sidebar">
        <div class="wordmark">
          <a class="wordmark-name" href="/"><Wordmark /></a>
        </div>

        <div class="experiment-picker">
          <label for="experiment-select" class="eyebrow">Experiment</label>
          <select id="experiment-select" data-suffix={sectionPaths[section]}>
            {
              site.experiments.map((e) => (
                <option value={e.name} selected={e.name === experiment}>
                  {e.name}
                </option>
              ))
            }
          </select>
        </div>

        <div class="nav-links">
          {
            navLinks.map((link) => (
              <a
                href={`/${experiment}/${sectionPaths[link.section]}`}
                aria-current={link.section === section ? "page" : undefined}
              >
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d={link.icon} />
                </svg>
                <span class="nav-label">{link.label}</span>
                {link.count !== null && <span class="nav-count">{link.count}</span>}
              </a>
            ))
          }
        </div>

        <div class="footer muted">
          <div class="mono">
            {site.headShortSha && `HEAD ${site.headShortSha} · `}py {site.pythonVersion}
          </div>
          <div>
            Logo emoji by <a href="https://openmoji.org/">OpenMoji</a>, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>
          </div>
        </div>
      </nav>

      <main class="content">
        <div class="content-inner">
          <slot />
        </div>
      </main>
    </div>

    <script>
      // Switching experiment keeps you in the same section of the new experiment.
      const select = document.getElementById("experiment-select") as HTMLSelectElement | null;
      select?.addEventListener("change", () => {
        window.location.href = `/${select.value}/${select.dataset.suffix ?? ""}`;
      });
    </script>
  </body>
</html>

<style>
  /* Sidebar and content wrap: on a narrow screen the sidebar stacks on top, no media query. */
  .shell {
    min-height: 100vh;
    display: flex;
    flex-wrap: wrap;
  }

  .sidebar {
    flex: 1 1 var(--sidebar-w);
    box-sizing: border-box;
    padding: 20px 14px;
    background: var(--c-panel);
    border-right: 1px solid var(--c-border);
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  /* Side by side (sidebar 232px + content 560px, plus a scrollbar), the sidebar
     stays put while the page scrolls, so the nav is always in view. Below
     that width it stacks on top, where sticking would cover the content. */
  @media (min-width: 820px) {
    .sidebar {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
    }
  }

  .content {
    flex: 999 1 560px;
    min-width: 0;
    box-sizing: border-box;
    padding: var(--content-pad);
  }
  .content-inner {
    max-width: 1200px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .wordmark {
    padding: 0 8px;
  }

  .experiment-picker {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 0 8px;
  }
  .experiment-picker .eyebrow {
    font-size: var(--fs-tiny);
  }
  .experiment-picker select {
    font: 500 14px var(--font-mono);
    min-height: 44px;
    background-color: var(--c-field);
  }

  .nav-links {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .nav-links a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 10px;
    min-height: var(--row-min-h);
    border-radius: var(--r-control);
    font-size: 14px;
    font-weight: 500;
    color: var(--c-ink-3);
    text-decoration: none;
  }
  .nav-links a[aria-current="page"] {
    font-weight: 600;
    color: var(--c-accent-strong);
    background: var(--c-accent-tint);
  }
  .nav-label {
    flex: 1;
  }
  .nav-count {
    font: 500 var(--fs-small) var(--font-mono);
    color: var(--c-muted);
  }
  .nav-links a[aria-current="page"] .nav-count {
    color: inherit;
  }

  /* Pushed to the bottom of the sidebar. */
  .footer {
    margin-top: auto;
    padding: 0 8px;
    font-size: var(--fs-tiny);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
</style>
